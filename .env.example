# Obtain the JDBC string from Supabase Dashboard > Connect > Session pooler.
# Do not commit a real password or JWT secret.
SUPABASE_DB_URL=jdbc:postgresql://aws-REGION.pooler.supabase.com:5432/postgres?user=postgres.PROJECT_REF&password=ENCODED_PASSWORD&sslmode=require
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
DB_POOL_SIZE=4
