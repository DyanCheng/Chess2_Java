# This must be the PostgreSQL JDBC string from Supabase Dashboard > Connect >
# Session pooler > JDBC. Do NOT use the Project URL (https://<ref>.supabase.co).
# The Session pooler uses port 5432; Transaction pooler (6543) is incompatible
# with Spring Data JPA/Hibernate prepared statements. Do not commit real secrets.
SUPABASE_DB_URL=jdbc:postgresql://aws-REGION.pooler.supabase.com:5432/postgres?user=postgres.PROJECT_REF&password=ENCODED_PASSWORD&sslmode=require
JWT_SECRET=replace-with-a-base64-encoded-secret-of-at-least-32-bytes
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
DB_POOL_SIZE=4
# SMTP is required for password-reset emails. Resend's SMTP credentials are a simple option.
SPRING_MAIL_HOST=smtp.resend.com
SPRING_MAIL_PORT=465
SPRING_MAIL_USERNAME=resend
SPRING_MAIL_PASSWORD=replace-with-smtp-password
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=true
MAIL_FROM=Chess2 <no-reply@example.com>
PUBLIC_APP_URL=http://localhost:8080/
